# --- Core ---
DATABASE_URL=postgres://user:pass@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me
PORT=3000

# DEMO_MODE documents the intended posture of this deployment (this repo is a
# portfolio/demo project). It isn't read by application code as a feature
# flag today — the demo behavior below is unconditional by design (OTP
# returned in the API response, social login accepting any token, card
# payments simulated) so the app is fully testable without live
# credentials. Set to "false" as a reminder once you wire up real
# providers below.
DEMO_MODE=true

# --- Payment gateways (unused while DEMO_MODE=true) ---
# Left blank on purpose: src/payments/adapters/jazzcash.adapter.ts and
# easypaisa.adapter.ts fall back to sandbox URLs + empty credentials, which
# still produces a validly-shaped/hashed request — just not backed by a real
# merchant account. Fill these in with real JazzCash/Easypaisa merchant
# portal credentials before going live.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
# Card payments (src/payments/adapters/card.adapter.ts) are fully simulated
# in demo mode and need no credentials at all. Add a Stripe/PayFast secret
# key here when replacing the adapter's mock authorize() call.
# STRIPE_SECRET_KEY=

# --- Notifications (unused — no live push in this demo) ---
FCM_SERVER_KEY=

# --- Object storage (unused — product images are seeded as picsum.photos URLs) ---
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
